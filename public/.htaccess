# ============================================================================
# Big Art Gallery — Apache (hosting Linux Aruba)
#
# I redirect HTTPS / www sono SPENTI di default.
# Accendili solo quando QUESTO sito è l'unico sul dominio (niente WordPress
# in root, niente "forza HTTPS" già attivo nel pannello Aruba).
# In una sottocartella di un WP esistente lasciarli accesi = ERR_TOO_MANY_REDIRECTS.
#
# Sottocartella (es. esempio.it/preview/):
#   1. Scommenta RewriteBase /preview/
#   2. ErrorDocument 404 /preview/404.html
#   3. Scommenta la RewriteRule ^en/ con path /preview/en/404.html
#   4. In 404.html e en/404.html: <base href="/preview/">
# Vedi DEPLOY.md.
# ============================================================================

Options -Indexes
DirectoryIndex index.html index.php

# ---------------------------------------------------------------------------
# File nascosti (.DS_Store del Mac, eventuali .git/.env caricati per errore)
# e file di lavoro: mai serviti. Rete di sicurezza — in public/ non
# dovrebbero esserci, ma il Finder crea .DS_Store da solo.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
<FilesMatch "\.(md|log|bak|sql|ini|env|sh|json|lock|orig|swp)$|~$">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# Rewrite — host/HTTPS solo a sito dedicato, non in cartella di test
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase /preview/

  # --- URL pulito: .../index.html -> .../ (301) ----------------------------
  # Per vecchi link e segnalibri: i link interni puntano già alla cartella.
  # THE_REQUEST è la richiesta originale del browser, quindi la DirectoryIndex
  # interna (/ -> index.html) non entra in loop. Funziona anche in
  # sottocartella: il path catturato include già /preview/.
  RewriteCond %{THE_REQUEST} \s(/(?:[^?\s]*/)?)index\.html[\s?]
  RewriteRule ^ %1 [R=301,L]

  # --- 404 sotto /en/ -------------------------------------------------------
  # Scommenta a go-live in root, insieme a ErrorDocument 404 /404.html.
  # In una sottocartella di test lascialo spento: /en/404.html punterebbe
  # fuori dalla cartella (e magari al WordPress in root).
  # In sottocartella a go-live: RewriteRule ^en/ /preview/en/404.html [L]
  #
  # RewriteCond %{REQUEST_FILENAME} !-f
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteRule ^en/ /en/404.html [L]

  # --- Canonico SENZA www + HTTPS (un solo 301) ---------------------------
  # Scommenta SOLO a go-live sul dominio vuoto, senza WordPress accanto.
  #
  # RewriteCond %{HTTPS} !=on [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- Alternativa: canonico CON www --------------------------------------
  # Se il dominio live è già www.qualcosa.com (come il WP attuale), usa
  # questo e non quello sopra.
  #
  # RewriteCond %{HTTPS} !=on [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  # RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# 404 personalizzata
# Path rispetto alla root del DOMINIO. In sottocartella cambia il path.
# Lasciata commentata in test: /404.html punterebbe al WordPress in root.
# A go-live in root: ErrorDocument 404 /404.html
# ---------------------------------------------------------------------------
# ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Cache asset statici
# HTML/PHP: niente cache lunga, così un aggiornamento FTP si vede subito.
# Immagini: 1 mese. CSS/JS: 1 settimana (si toccano più spesso delle foto).
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/php "access plus 0 seconds"

  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"

  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"

  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"

  # Il sito carica solo risorse proprie: niente CDN, font esterni, analytics.
  # Se un giorno si aggiunge un servizio esterno (mappa, video, statistiche)
  # va aggiunto qui il suo dominio, altrimenti il browser lo blocca.
  # style.setProperty() da JS (main.js) è ammesso anche con style-src 'self'.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header set Cross-Origin-Opener-Policy "same-origin"

  # Scommenta dopo aver verificato che HTTPS risponde su tutto il sito:
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Compressione testo. Le foto sono già compressi: gzip su jpeg è spreco.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
